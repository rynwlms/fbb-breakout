# Upstash Redis credentials for the global leaderboard (Vercel Marketplace
# integration). Local dev works without these — the /api/scores endpoint
# returns { enabled: false } and the game falls back to local-only scoring.
# In production these are injected automatically when you add the Upstash
# Redis integration to the Vercel project. Either KV_REST_API_* or
# UPSTASH_REDIS_REST_* variable names are accepted.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
